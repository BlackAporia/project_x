# Copy to .env for local runs (never commit .env). All values are optional.
# Mainnet (Cartridge session is created with `npm run authorize`; in CI use the CARTRIDGE_SESSION_B64 secret)
MAINNET_ACCOUNT_ADDRESS=
MAINNET_LIVE=false
# Overrides when contracts are redeployed (see src/chain/config.ts for the full list)
# GAME_CORE_ADDRESS=
# VRF_CALLER=
# STARKNET_RPC_URLS=https://api.cartridge.gg/x/starknet/mainnet/rpc/v0_9
# PRACTICE_RPC_URLS=https://api.cartridge.gg/x/pg-slot-4/katana
